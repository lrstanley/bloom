// Deploys the static docs build as an assets-only Worker (no "main", so no Worker code runs).
// https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "bloom-docs",
  "compatibility_date": "2026-11-02",
  // opt out of wrangler's usage metrics (overrides the user's own preference).
  "send_metrics": false,
  // "bun run preview" serves the build with wrangler dev, which doesn't read vite's preview.host.
  "dev": {
    "ip": "0.0.0.0"
  },
  "assets": {
    "directory": "./dist/public",
    "not_found_handling": "404-page",
    // pages are emitted as <path>/index.html but linked (and canonicalized) without a trailing slash.
    "html_handling": "drop-trailing-slash"
  }
}
